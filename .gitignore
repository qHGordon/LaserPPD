# Unity .gitignore
# 参考: https://github.com/github/gitignore/blob/main/Unity.gitignore

# -----------------------------------------------------------------------
# Unity 生成的核心目录（不应提交）
# -----------------------------------------------------------------------
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/

# IL2CPP 编译产物
/[Ii]l2CppOutputProject/
**/[Aa]ndroid/[Ii]l2CppOutputProject/

# MemoryCaptures 可能包含敏感数据且体积庞大
/[Mm]emoryCaptures/

# Recordings 体积庞大
/[Rr]ecordings/

# -----------------------------------------------------------------------
# IDE 与编辑器
# -----------------------------------------------------------------------
# Visual Studio
.vs/
ExportedObj/
.consulo/

# JetBrains Rider 自动生成插件
/[Aa]ssets/Plugins/Editor/JetBrains*
.idea/

# VSCode
.vscode/

# -----------------------------------------------------------------------
# 自动生成的解决方案与项目文件
# -----------------------------------------------------------------------
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity 重新生成的项目文件
Assembly-CSharp*.csproj
Assembly-CSharp-Editor*.csproj
*.Editor.csproj

# Unity3D 生成的 meta 文件
*.pidb.meta
*.pdb.meta
*.mdb.meta

# -----------------------------------------------------------------------
# 构建产物
# -----------------------------------------------------------------------
# Android
*.apk
*.aab
*.aar
/[Aa]ndroid/
/[Gg]radle*/
.gradle/

# iOS / macOS / Windows
*.app
*.exe
*.x86
*.x86_64
*.so

# WebGL
/[Ww]eb[Gg][Ll]/

# -----------------------------------------------------------------------
# 第三方与平台工具
# -----------------------------------------------------------------------
# Crashlytics
crashlytics-build.properties

# Packed Addressables
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Temporary auto-generated Android Assets
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# Nuget 包（Unity Nuget 插件）
/[Pp]ackages/
!/[Pp]ackages/manifest.json
!/[Pp]ackages/packages-lock.json

# Unity Asset Store 工具（如需保留请注释此行）
# /[Aa]ssets/AssetStoreTools*

# Unity3D 崩溃报告
sysinfo.txt

# -----------------------------------------------------------------------
# 操作系统生成文件
# -----------------------------------------------------------------------
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Windows
ehthumbs.db
Thumbs.db
desktop.ini

# Linux
*~

# -----------------------------------------------------------------------
# 项目自定义：保留的脚本与文档
# -----------------------------------------------------------------------
# Python scripts (if you want to keep them, remove these lines)
# *.py
# *.pyc
# __pycache__/

!cleanup_project_files.py
!context_code.py
!DEVELOPMENT.md
!README*.md
!代码重构分析报告*.md